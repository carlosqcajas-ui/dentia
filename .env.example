# Database
# docker-compose.yml no longer provisions a local Postgres container —
# point this at any reachable Postgres 15 instance (a Supabase project's
# connection string, or your own self-hosted Postgres).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32

# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
API_BASE_URL=http://localhost:8000
